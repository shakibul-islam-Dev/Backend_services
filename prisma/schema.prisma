generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  username String
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  role Role @default(USER)
  avatar String?
  phone String?
  adress String?
  @@map("users_table")
  @@index([email,username,id])
  orders Order[]
}

model Product{
  produt_id String @id @default(uuid())
  title String
  quantity Int
  description String
  short_description String
  stock Int
  discount_id Int
  list_price Int
  sale_price Int
  currency_type String
  @@map("products_table")

}
model Order{
  order_id Int @id
  userId String
  user User @relation(fields: [userId],references: [id])
  order_number Int
  order_quitnty Int
  payment_id Int
  order_date DateTime
  time_stamp String
  transact_status String
  payment_date DateTime
  @@map("Orders_table")
}
model Categories{
  category_id Int @id
  parent_id Int
  name String
  subCategories Boolean
}

model Reviews{
  reviews_id Int @id
  rating String
  comment String?
}

enum Role{
  USER
  ADMIN 
}
